{
  "name": "frankcards",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Thoughtfully curated conversation cards for deeper human connection",
  "author": "FrankCards",
  "keywords": [
    "conversation",
    "cards",
    "communication",
    "relationships",
    "tauri",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-games && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate-games": "node scripts/generate-game-index.js",
    "icons:generate": "tauri icon src-tauri/icons/frankcards-app-icon.png --output src-tauri/icons --ios-color '#f7f7f1'",
    "ios:sync-icons": "npm run icons:generate && node scripts/sync-ios-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@chenglou/pretext": "^0.0.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@supabase/supabase-js": "^2.58.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.85",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "motion": "^12.23.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
